# PostgreSQL
DB_URL=jdbc:postgresql://postgres:5432/interview_fit
DB_USERNAME=interview
DB_PASSWORD=your_db_password

# Kakao OAuth2
KAKAO_REDIRECT_URI=https://your_frontend_domain/oauth/kakao/callback
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# JWT
JWT_SECRET=your_jwt_secret
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAME_SITE=None
JWT_COOKIE_DOMAIN=

# LiveKit
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your_livekit_server_url

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_password
MINIO_BUCKET=interview-videos

# FastAPI
FASTAPI_BASE_URL=http://fastapi:8000

# Group Interview
GROUP_INTERVIEW_COMPARISON_FEEDBACK_ENABLED=true