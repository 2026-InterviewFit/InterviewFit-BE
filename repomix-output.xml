            Long actorUserId,
            InterviewProgressResponse progress
    ) {
        return GroupRoomEvent.builder()
                .type(type)
                .roomId(roomId)
                .actorUserId(actorUserId)
                .progress(progress)
                .occurredAt(OffsetDateTime.now())
                .build();
    }
